{
  "manifest_version": 3,
  "name": "Media Collector",
  "version": "0.5.1",
  "description": "Web sayfalarında medya tarama, tıklayarak seçim ve düzenli klasörlere kaydetme araçları.",
  "minimum_chrome_version": "109",
  "permissions": [
    "downloads",
    "scripting",
    "storage",
    "tabs",
    "webRequest",
    "declarativeNetRequest",
    "offscreen"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_title": "Media Collector",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "key": ""
}
